{
  "manifest_version": 3,
  "name": "DOMShield Hybrid: On-Device Anti-Scam & Dark-Pattern Firewall",
  "version": "1.0.0",
  "description": "Detects and neutralizes deceptive checkout dark patterns and phishing forms on-device with Gemini Nano and Firebase Hybrid AI.",
  "permissions": ["sidePanel", "tabs", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open DOMShield Hybrid Firewall"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
